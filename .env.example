# Public Supabase values. The publishable/anon key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Gemini configuration. Keep the API key out of client code.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Server-only values. Do not expose service-role keys to the browser.
# SUPABASE_SERVICE_ROLE_KEY=server-only-key-if-a-trusted-admin-job-is-added
